# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - app will run with local sync fallback if not yet set)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Admin Bootstrap Code (Server-side only secret for bootstrapping administrator role)
ADMIN_BOOTSTRAP_CODE="agritechkivu26"
